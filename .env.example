# Copy to .env and change every value marked CHANGE_ME. Never commit .env.
POSTGRES_PASSWORD=CHANGE_ME_local_db_password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PDM_JWT_SECRET=CHANGE_ME_at_least_32_random_characters_long
PDM_ENV=development
# Behind plain http://localhost the refresh cookie cannot be "Secure". Set true in production (HTTPS).
PDM_COOKIE_SECURE=false
PDM_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
PDM_LOG_LEVEL=INFO
PDM_LOG_JSON=true
PDM_PREDICTION_HORIZON_DAYS=7
# Used only by `python -m app.cli demo/create-admin` to create the first admin non-interactively.
PDM_ADMIN_PASSWORD=CHANGE_ME_admin_password
# Optional: store model artifacts in S3 instead of the local volume (AWS deployment).
# PDM_ARTIFACT_S3_BUCKET=
